# Native MTP checkpoint profile for one RTX 5090. Copy to profile.env to select it.
# This checkpoint is already materialized under MODEL_ROOT; setup does not download it.
REPO_ROOT=$HOME/Qwen3.8-27B-RTX5090-SGLang-DFlash
DEPLOY_ROOT=$HOME/Qwen3.8-27B-RTX5090-SGLang-DFlash
MODEL_ROOT=/root/models
PROFILE=rtx5090-native-mtp-nvfp4
PORT=1234
CONTAINER_NAME=qwen38-sglang-native-mtp

# Rebuilt bounded SGLang image; setup verifies its pinned provenance labels.
BOUNDED_IMAGE_REF=local/sglang:qwen38-bounded-dflash-a1fe4e30
TARGET_REPO=Jackrong/Qwopus3.8-27B-Flash-NVFP4-MTP
ENGINE=native_mtp
SERVED_MODEL_NAME=qwopus3.8-27b-nvfp4-mtp
SETUP_MODE=existing

CONTEXT_LENGTH=131072
MAX_TOTAL_TOKENS=129241
CHUNKED_PREFILL_SIZE=1024
MAX_MAMBA_CACHE_SIZE=1
MEM_FRACTION_STATIC=0.96
MAX_RUNNING_REQUESTS=1
RANDOM_SEED=42
KV_CACHE_DTYPE=fp8_e4m3
