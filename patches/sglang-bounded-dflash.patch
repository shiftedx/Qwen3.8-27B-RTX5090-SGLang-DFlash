@@ -326,6 +326,85 @@ def rebuild_compact_draft_req_to_token_func(
     )
 
 
+@triton.jit
+def rebuild_bounded_draft_req_to_token(
+    draft_req_to_token,
+    req_pool_indices,
+    suffix_start,
+    draft_prefix_lens,
+    scratch_cache_loc,
+    scratch_loc_stride,
+    draft_pool_len: tl.constexpr,
+    window_tokens: tl.constexpr,
+    block_size: tl.constexpr,
+):
+    """Rebuild a draft-local ring row without reading target physical ids."""
+    BLOCK: tl.constexpr = 256
+    pid = tl.program_id(axis=0)
+    req = tl.load(req_pool_indices + pid).to(tl.int64)
+    start = tl.load(suffix_start + pid).to(tl.int64)
+    prefix_len = tl.load(draft_prefix_lens + pid).to(tl.int64)
+    total = prefix_len + block_size
+
+    dst_row = draft_req_to_token + req * draft_pool_len
+    scratch_row = scratch_cache_loc + pid * scratch_loc_stride
+
+    offs = tl.arange(0, BLOCK).to(tl.int64)
+    num_loop = tl.cdiv(total, BLOCK)
+    for i in range(num_loop):
+        col = offs + i * BLOCK
+        in_prefix = col < prefix_len
+        in_block = (col >= prefix_len) & (col < total)
+        absolute_pos = start + col
+        committed = 1 + absolute_pos % window_tokens
+        scratch = tl.load(scratch_row + (col - prefix_len), mask=in_block, other=0)
+        value = tl.where(in_prefix, committed, scratch)
+        tl.store(dst_row + col, value, mask=in_prefix | in_block)
+
+
+def rebuild_bounded_draft_req_to_token_func(
+    *,
+    draft_req_to_token: torch.Tensor,
+    req_pool_indices: torch.Tensor,
+    suffix_start: torch.Tensor,
+    draft_prefix_lens: torch.Tensor,
+    scratch_cache_loc_2d: torch.Tensor,
+    batch_size: int,
+    block_size: int,
+    window_tokens: int,
+) -> None:
+    if draft_req_to_token.device.type == "cpu":
+        for batch_idx in range(batch_size):
+            req = int(req_pool_indices[batch_idx])
+            start = int(suffix_start[batch_idx])
+            prefix_len = int(draft_prefix_lens[batch_idx])
+            absolute_positions = torch.arange(
+                start,
+                start + prefix_len,
+                dtype=torch.int64,
+                device=draft_req_to_token.device,
+            )
+            draft_req_to_token[req, :prefix_len] = (
+                torch.remainder(absolute_positions, window_tokens) + 1
+            )
+            draft_req_to_token[req, prefix_len : prefix_len + block_size] = (
+                scratch_cache_loc_2d[batch_idx, :block_size]
+            )
+        return
+
+    rebuild_bounded_draft_req_to_token[(batch_size,)](
+        draft_req_to_token,
+        req_pool_indices,
+        suffix_start,
+        draft_prefix_lens,
+        scratch_cache_loc_2d,
+        scratch_cache_loc_2d.stride(0),
+        draft_req_to_token.shape[1],
+        window_tokens,
+        block_size,
+    )
+
