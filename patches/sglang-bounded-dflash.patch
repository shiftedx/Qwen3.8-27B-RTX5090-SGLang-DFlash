diff --git a/python/sglang/srt/speculative/dflash_bounded_cache.py b/python/sglang/srt/speculative/dflash_bounded_cache.py
new file mode 100644
index 0000000000..4a4509c83c
--- /dev/null
+++ b/python/sglang/srt/speculative/dflash_bounded_cache.py
@@ -0,0 +1,45 @@
+from dataclasses import dataclass
+
+import torch
+
+
+@dataclass(frozen=True, slots=True)
+class DFlashBoundedCacheLayout:
+    window_tokens: int
+    block_tokens: int
+    guard_tokens: int = 1
+
+    def __post_init__(self) -> None:
+        if self.window_tokens <= 0:
+            raise ValueError("window_tokens must be positive")
+        if self.block_tokens <= 0 or self.block_tokens > self.window_tokens:
+            raise ValueError("block_tokens must be in [1, window_tokens]")
+        if self.guard_tokens < 1:
+            raise ValueError("guard_tokens must be positive")
+
+    @property
+    def scratch_start(self) -> int:
+        return 1 + self.window_tokens
+
+    @property
+    def pool_tokens(self) -> int:
+        return self.scratch_start + self.block_tokens + self.guard_tokens
+
+    def committed_slots(self, positions: torch.Tensor) -> torch.Tensor:
+        """Map positions into the ring, normalizing negative sentinels to -1."""
+        positions = positions.to(torch.int64)
+        slots = torch.remainder(positions, self.window_tokens).add(1)
+        return torch.where(positions < 0, -1, slots)
+
+    def scratch_slots(self, device: torch.device | str) -> torch.Tensor:
+        return torch.arange(
+            self.scratch_start,
+            self.scratch_start + self.block_tokens,
+            dtype=torch.int64,
+            device=device,
+        )
+
+    def fixed_bytes(self, bytes_per_token: int) -> int:
+        if bytes_per_token <= 0:
+            raise ValueError("bytes_per_token must be positive")
+        return self.pool_tokens * bytes_per_token
